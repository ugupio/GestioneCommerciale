    // --- HELPER DI RICERCA NEL CATALOGO ALLINEATI AL DATABASE DI FP PRO ---
    private double OttieniLunghezzaBarra(string tipo)
    {
        int idSerieFpPro = elemento.SerieProfilo == "CX650" ? 48 : (elemento.SerieProfilo == "RX450" ? 12 : 0);
        var profilo = CatalogoProfili.FirstOrDefault(p => p.SerieSerramentoId == idSerieFpPro && p.TipoProfilo == tipo);
        return profilo?.LunghezzaCommercialeBarra ?? 6.0;
    }

    private string OttieniCodiceArticolo(string tipo)
    {
        int idSerieFpPro = elemento.SerieProfilo == "CX650" ? 48 : (elemento.SerieProfilo == "RX450" ? 12 : 0);
        var profilo = CatalogoProfili.FirstOrDefault(p => p.SerieSerramentoId == idSerieFpPro && p.TipoProfilo == tipo);
        return profilo?.CodiceArticolo ?? "COD-ERR";
    }

    private string OttieniDescrizioneArticolo(string tipo)
    {
        int idSerieFpPro = elemento.SerieProfilo == "CX650" ? 48 : (elemento.SerieProfilo == "RX450" ? 12 : 0);
        var profilo = CatalogoProfili.FirstOrDefault(p => p.SerieSerramentoId == idSerieFpPro && p.TipoProfilo == tipo);
        return profilo?.Descrizione ?? "Articolo non trovato a catalogo";
    }


