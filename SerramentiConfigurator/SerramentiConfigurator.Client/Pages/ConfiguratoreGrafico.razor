    // Helper di estrazione delle proprietà fisiche degli articoli a database
    

    

    

    

    // --- CALCOLO METRATURE GEOMETRICHE AL MILLIMETRO ---
    private int LarghezzaUtileAnta => elemento.HaFiancoluce ? (elemento.Larghezza - elemento.LarghezzaFiancoluce) : elemento.Larghezza;
    private int AltezzaUtileAnta => elemento.HaSopraluce ? (elemento.Altezza - elemento.AltezzaSopraluce) : elemento.Altezza;

    // Sfrido sul telaio calcolato esclusivamente sui lati attivi
    private double MetriLineariTelaio => Math.Round(((elemento.TelaioSuperiore ? elemento.Larghezza : 0) + (elemento.TelaioInferiore ? elemento.Larghezza : 0) + (elemento.TelaioSinistro ? elemento.Altezza : 0) + (elemento.TelaioDestro ? elemento.Altezza : 0)) / 1000.0, 2);
    
    // Sfrido sulle ante riproporzionato in base al numero di ante attive e alla presenza dello zoccolo
    private double MetriLineariAnta => Math.Round((
        (elemento.NumeroAnte * ((LarghezzaUtileAnta - 80) / elemento.NumeroAnte * 2)) +
        (elemento.NumeroAnte * ((AltezzaUtileAnta - 80) * 2))
    ) / 1000.0, 2);

    private double MetriLineariFermavetro => Math.Round((((elemento.Larghezza - 140) * 2) + ((elemento.Altezza - 140) * 2)) / 1000.0, 2);
    private double MetriLineariRiportoCentrale => elemento.NumeroAnte == 2 ? Math.Round((AltezzaUtileAnta - 80) / 1000.0, 2) : 0;
    private double MetriLineariTraversoSopraluce => elemento.HaSopraluce ? Math.Round(elemento.Larghezza / 1000.0, 2) : 0;
    private double MetriLineariMontanteFiancoluce => elemento.HaFiancoluce ? Math.Round(elemento.Altezza / 1000.0, 2) : 0;
    private double MetriLineariZoccolo => elemento.AntaHaZoccoloInferiore ? Math.Round((LarghezzaUtileAnta - 80) / 1000.0, 2) : 0;

    // --- CALCOLO ORDINATIVI COMMERCIALI B2B (Divisione per lunghezza barra di serie) ---
    private int BarreTelaio => (int)Math.Ceiling(MetriLineariTelaio / OttieniLunghezzaBarra("Telaio"));
    private int BarreAnta => (int)Math.Ceiling(MetriLineariAnta / OttieniLunghezzaBarra("Anta"));
    private int BarreFermavetro => (int)Math.Ceiling(MetriLineariFermavetro / OttieniLunghezzaBarra("Fermavetro"));
    private int BarreRiporto => (int)Math.Ceiling(MetriLineariRiportoCentrale / OttieniLunghezzaBarra("Inversore"));
    private int BarreTraversiT => (int)Math.Ceiling((MetriLineariTraversoSopraluce + MetriLineariMontanteFiancoluce) / OttieniLunghezzaBarra("TraversoT"));
    private int BarreZoccolo => (int)Math.Ceiling(MetriLineariZoccolo / OttieniLunghezzaBarra("Zoccolo"));

    // --- LOGICA ACCESSORI ---
    private int PezziCerniere => elemento.VersoApertura == "Vasistas" ? 2 : 3;
    private string DescrizioneKitFerramenta => elemento.VersoApertura == "Vasistas" ? "Kit Chiusura Vasistas" : $"Kit Meccanismo {elemento.TipoAperturaFerramenta}";

