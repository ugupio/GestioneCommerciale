    private async Task SalvaZona(Zona z)
    {
        try
        {
            using IDbConnection db = new SqlConnection(conn);
            if (z.IdZona == 0)
            {
                string sql = "INSERT INTO Zone (NomeZona, Descrizione) VALUES (@NomeZona, @Descrizione); SELECT CAST(SCOPE_IDENTITY() as int)";
                z.IdZona = await db.QuerySingleAsync<int>(sql, z);
            }
            else
            {
                string sql = "UPDATE Zone SET NomeZona = @NomeZona, Descrizione = @Descrizione WHERE IdZona = @IdZona";
                await db.ExecuteAsync(sql, z);
            }
            await JSRuntime.InvokeVoidAsync("alert", "Zona salvata con successo!");
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", "Errore: " + ex.Message); }
    }

    private async Task EliminaZona(Zona z)
    {
        if (z.IdZona == 0) { ListeZone.Remove(z); return; }

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Eliminare definitivamente la zona {z.NomeZona}?");
        if (confirm)
        {
            using IDbConnection db = new SqlConnection(conn);
            await db.ExecuteAsync("DELETE FROM Zone WHERE IdZona = @IdZona", new { z.IdZona });
            ListeZone.Remove(z);
        }
    }

