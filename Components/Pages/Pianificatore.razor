    private async Task CalcolaGiro()
{
    // 1. LOG DI PARTENZA (Lo vedrai nella finestra Output di VS)
    System.Diagnostics.Debug.WriteLine("Inizio CalcolaGiro...");

    try 
    {
        // 2. CONTROLLO DATI MINIMI
        if (IdZonaSelezionata == 0) {
             await JSRuntime.InvokeVoidAsync("alert", "Seleziona prima una Zona!");
             return;
        }

        // 3. RECUPERO COORDINATE (Usiamo il service)
        // Se si pianta qui, il problema è la connessione all'API di LocationIQ
        // var coords = await PlannerService.GeocodificaIndirizzo(IndirizzoPartenza);
        
        // if (coords == null) {
          //  await JSRuntime.InvokeVoidAsync("alert", "Indirizzo non trovato. Controlla la connessione!");
          //  return;
       // }

        LatPartenza = 42.93797;
        LonPartenza = 10.51930;

        // 4. CARICAMENTO CLIENTI (SQL DIRETTO)
        using (var db = new System.Data.SqlClient.SqlConnection(conn))
        {
            var sql = @"
                SELECT c.* 
                FROM Clienti c
                OUTER APPLY (
                    SELECT TOP 1 DataVisita 
                    FROM Visite v 
                    WHERE v.IdCliente = c.IdCliente 
                    ORDER BY DataVisita DESC
                ) lastV
                WHERE c.IdZona = @IdZona 
                  AND c.Lat IS NOT NULL 
                  AND (
                       lastV.DataVisita IS NULL 
                       OR DATEDIFF(day, lastV.DataVisita, GETDATE()) >= ISNULL(c.FrequenzaVisitaGg, 0)
                  )";
            var clienti = (await db.QueryAsync<Cliente>(sql, new { IdZona = IdZonaSelezionata })).ToList();

                if (clienti != null && clienti.Any())
                {
                    // 5. CALCOLO LOGICA (PianificatoreService)
                    GiroProposto = PlannerService.CalcolaGiroOttimizzato(
                    clienti, 
                    LatPartenza, 
                    LonPartenza, 
                    IsRientroPranzo, 
                    20, // durata visita
                    OrarioPartenzaPrevisto, // <--- NUOVO PARAMETRO
                    OrarioRientroMassimo    // <--- NUOVO PARAMETRO
                    );

                    // Copia lat/lon nelle tappe e inizializza Selected=true
                    var clientiById = clienti.ToDictionary(c => c.IdCliente);
                    foreach (var t in GiroProposto)
                    {
                        if (clientiById.TryGetValue(t.IdCliente, out var c))
                        {
                            t.Lat = c.Lat;
                            t.Lon = c.Lon;
                            t.Selected = true;
                        }
                    }
                }
            else 
            {
                await JSRuntime.InvokeVoidAsync("alert", "Nessun cliente con coordinate trovato in questa zona!");
            }
        }
        
        // 6. AGGIORNA INTERFACCIA
        StateHasChanged();
    }
    catch (Exception ex)
    {
        // Se c'è un errore C#, lo catturiamo qui invece di far crashare la pagina
        System.Diagnostics.Debug.WriteLine($"CRASH: {ex.Message}");
        await JSRuntime.InvokeVoidAsync("alert", "Errore tecnico: " + ex.Message);
    }
}




    private async Task SalvaAgenda()
{
    if (GiroProposto == null || !GiroProposto.Any())
    {
        await JSRuntime.InvokeVoidAsync("alert", "Nessun giro calcolato da salvare!");
        return;
    }

    try
    {
        using (var db = new System.Data.SqlClient.SqlConnection(conn))
        {
            string sqlInsert = @"
                INSERT INTO Agenda (IdCliente, DataInizio, DataFine, Titolo, Tipo, Dettaglio, IsChiuso, Priorita)
                VALUES (@IdCliente, @DataInizio, @DataFine, @Titolo, 'VISITA', @Dettaglio, 0, 1)";

            // Prima: raccogliamo le tappe selezionate da salvare
            var toSave = GiroProposto.Where(t => t.Selected).ToList();

            // Cerchiamo eventuali appuntamenti esistenti per la stessa data e cliente
            string sqlExisting = @"SELECT IdAgenda, IdCliente, DataInizio, DataFine, Titolo FROM Agenda WHERE CONVERT(date, DataInizio) = @Data";
            var existing = (await db.QueryAsync(sqlExisting, new { Data = DataPianificazione.Date }))
                          .Select(r => new { IdAgenda = (int)r.IdAgenda, IdCliente = (int)r.IdCliente, DataInizio = (DateTime)r.DataInizio, DataFine = (DateTime)r.DataFine, Titolo = (string)r.Titolo })
                          .ToList();

            // Costruiamo conflitti
            SaveConflicts = new List<ConflictItem>();
            foreach (var t in toSave)
            {
                var conflicts = existing.Where(e => e.IdCliente == t.IdCliente).ToList();
                if (conflicts.Any())
                {
                    SaveConflicts.Add(new ConflictItem { Proposed = t, Existing = conflicts.Select(c => new ExistingAgenda { Titolo = c.Titolo, DataInizio = c.DataInizio, DataFine = c.DataFine }).ToList(), Save = true });
                }
            }

            if (SaveConflicts.Any())
            {
                // Mostriamo modal per scelta all'utente
                showConflictsModal = true;
                return;
            }

            // Nessun conflitto: procediamo con il salvataggio
            foreach (var tappa in toSave)
            {
                DateTime inizioPianificato = DataPianificazione.Date.Add(tappa.OrarioArrivo.TimeOfDay);
                DateTime finePianificata = DataPianificazione.Date.Add(tappa.OrarioPartenza.TimeOfDay);

                await db.ExecuteAsync(sqlInsert, new
                {
                    IdCliente = tappa.IdCliente,
                    DataInizio = inizioPianificato,
                    DataFine = finePianificata,
                    Titolo = $"Visita: {tappa.RagSociale}",
                    Dettaglio = $"Giro ottimizzato. KM previsti: {tappa.KmDaPuntoPrecedente:N1}"
                });
            }
        }

        await JSRuntime.InvokeVoidAsync("alert", $"Agenda per il {DataPianificazione:dd/MM/yyyy} salvata correttamente!");
    }
    catch (Exception ex)
    {
        await JSRuntime.InvokeVoidAsync("alert", "Errore nel salvataggio: " + ex.Message);
    }
}

    // Gestione selezione tappe e ricalcolo orari mantenendo l'ordine
    private void OnTappaSelectionChanged(TappaGiro tappa, ChangeEventArgs e)
    {
        bool isChecked = false;
        if (e.Value is bool b) isChecked = b;
        else if (e.Value is string s) isChecked = s == "on" || s == "true";
        tappa.Selected = isChecked;

        RicalcolaOrariDopoSelezione();
    }

    private void RicalcolaOrariDopoSelezione()
    {
        DateTime oraCorrente = DataPianificazione.Date.Add(OrarioPartenzaPrevisto);
        double latAttuale = LatPartenza;
        double lonAttuale = LonPartenza;

        foreach (var t in GiroProposto)
        {
            if (!t.Selected)
            {
                continue;
            }

            double dist = 0;
            if (t.Lat.HasValue && t.Lon.HasValue)
            {
                dist = CalcolaDistanzaKM(latAttuale, lonAttuale, t.Lat.Value, t.Lon.Value);
            }

            int minutiViaggio = (int)(dist * 0.9);
            if (minutiViaggio < 5 && dist > 0.1) minutiViaggio = 5;

            DateTime arrivoPrevisto = oraCorrente.AddMinutes(minutiViaggio);
            DateTime fineVisita = arrivoPrevisto.AddMinutes(20);

            t.OrarioArrivo = arrivoPrevisto;
            t.OrarioPartenza = fineVisita;

            oraCorrente = fineVisita;
            if (t.Lat.HasValue && t.Lon.HasValue)
            {
                latAttuale = t.Lat.Value; lonAttuale = t.Lon.Value;
            }
        }

        StateHasChanged();
    }

    // Copia della funzione Haversine per calcolo distanze (km)
    private double CalcolaDistanzaKM(double lat1, double lon1, double lat2, double lon2)
    {
        if (lat1 == 0 || lat2 == 0) return 0;

        double dLat = (lat2 - lat1) * Math.PI / 180;
        double dLon = (lon2 - lon1) * Math.PI / 180;
        double a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                   Math.Cos(lat1 * Math.PI / 180) * Math.Cos(lat2 * Math.PI / 180) *
                   Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        double c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));

        return 6371 * c;
    }

    // Azioni toolbar: seleziona/deseleziona tutte e ottimizza ordine
    private void SelectAllTappe()
    {
        if (GiroProposto == null) return;
        foreach (var t in GiroProposto) t.Selected = true;
        RicalcolaOrariDopoSelezione();
    }

    private void DeselectAllTappe()
    {
        if (GiroProposto == null) return;
        foreach (var t in GiroProposto) t.Selected = false;
        RicalcolaOrariDopoSelezione();
    }

    private void OttimizzaOrdine()
    {
        if (GiroProposto == null || !GiroProposto.Any()) return;

        // Nearest-neighbour greedy sulle tappe selezionate
        var selezionate = GiroProposto.Where(t => t.Selected).ToList();
        var nonSelezionate = GiroProposto.Where(t => !t.Selected).ToList();

        var ordered = new List<TappaGiro>();
        double lat = LatPartenza, lon = LonPartenza;

        while (selezionate.Any())
        {
            var next = selezionate.OrderBy(t => CalcolaDistanzaKM(lat, lon, t.Lat ?? lat, t.Lon ?? lon)).First();
            ordered.Add(next);
            selezionate.Remove(next);
            if (next.Lat.HasValue && next.Lon.HasValue) { lat = next.Lat.Value; lon = next.Lon.Value; }
        }

        GiroProposto = ordered.Concat(nonSelezionate).ToList();
        RicalcolaOrariDopoSelezione();
    }

    // RIEMPI GIORNATA: aggiunge clienti finché c'è tempo utile
    private async Task RiempiGiornata()
    {
        if (GiroProposto == null) GiroProposto = new List<TappaGiro>();

        // Carichiamo candidati dalla stessa zona selezionata
        List<Cliente> pool;
        using (var db = new SqlConnection(conn))
        {
            var sql = @"SELECT c.* FROM Clienti c WHERE c.IdZona = @IdZona AND c.Lat IS NOT NULL";
            pool = (await db.QueryAsync<Cliente>(sql, new { IdZona = IdZonaSelezionata })).ToList();
        }

        // Rimuoviamo i clienti già presenti nella proposta
        var existingIds = GiroProposto.Select(t => t.IdCliente).ToHashSet();
        var candidates = pool.Where(c => !existingIds.Contains(c.IdCliente)).ToList();

        // Iniziamo dal punto di partenza o dall'ultima tappa selezionata
        DateTime oraCorrente = DataPianificazione.Date.Add(OrarioPartenzaPrevisto);
        double lat = LatPartenza, lon = LonPartenza;
        var lastSelected = GiroProposto.LastOrDefault(t => t.Selected);
        if (lastSelected != null)
        {
            oraCorrente = DataPianificazione.Date.Add(lastSelected.OrarioPartenza.TimeOfDay);
            if (lastSelected.Lat.HasValue && lastSelected.Lon.HasValue) { lat = lastSelected.Lat.Value; lon = lastSelected.Lon.Value; }
        }

        int durataVisita = 20; // minuti

        // Greedy: aggiungi il candidato più vicino finché non superi l'orario di rientro
        while (candidates.Any())
        {
            var next = candidates.OrderBy(c => CalcolaDistanzaKM(lat, lon, c.Lat ?? lat, c.Lon ?? lon)).FirstOrDefault();
            if (next == null) break;

            double dist = CalcolaDistanzaKM(lat, lon, next.Lat ?? lat, next.Lon ?? lon);
            int minutiViaggio = (int)(dist * 0.9);
            if (minutiViaggio < 5 && dist > 0.1) minutiViaggio = 5;

            DateTime arrivo = oraCorrente.AddMinutes(minutiViaggio);
            DateTime fine = arrivo.AddMinutes(durataVisita);

            // Gestione pausa pranzo: aziende chiudono 12:00-14:00
            var lunchStart = DataPianificazione.Date.AddHours(12);
            var lunchEnd = DataPianificazione.Date.AddHours(14);
            // Se la visita finisce durante la pausa pranzo, adattiamo
            if ((fine > lunchStart && fine < lunchEnd) || (arrivo < lunchEnd && fine > lunchStart))
            {
                var ripartenzaPomeriggio = DataPianificazione.Date.AddHours(14);
                if (IsRientroPranzo)
                {
                    // Torniamo a casa per pranzo e ripartiamo alle 14 calcolando il viaggio da casa
                    double distFromHome = CalcolaDistanzaKM(LatPartenza, LonPartenza, next.Lat ?? lat, next.Lon ?? lon);
                    int minutiViaggioPomeriggio = (int)(distFromHome * 0.9);
                    if (minutiViaggioPomeriggio < 5 && distFromHome > 0.1) minutiViaggioPomeriggio = 5;
                    arrivo = ripartenzaPomeriggio.AddMinutes(minutiViaggioPomeriggio);
                    fine = arrivo.AddMinutes(durataVisita);

                    // dopo il pranzo la posizione corrente diventa quella del cliente quando partirai
                }
                else
                {
                    // Rimani sul campo e aspetti le 14:00
                    arrivo = ripartenzaPomeriggio;
                    fine = arrivo.AddMinutes(durataVisita);
                }
            }

            // tempo per tornare a casa
            double distRitorno = CalcolaDistanzaKM(next.Lat ?? lat, next.Lon ?? lon, LatPartenza, LonPartenza);
            int minRitorno = (int)(distRitorno * 0.9);

            DateTime possibileRientro = fine.AddMinutes(minRitorno);
            DateTime limite = DataPianificazione.Date.Add(OrarioRientroMassimo);

            if (possbileRientroExceeds(limite, possibileRientro)) break;

            // Aggiungiamo la tappa
            GiroProposto.Add(new TappaGiro
            {
                IdCliente = next.IdCliente,
                RagSociale = next.RagSociale,
                Citta = next.Citta_Legale,
                OrarioArrivo = arrivo,
                OrarioPartenza = fine,
                KmDaPuntoPrecedente = dist,
                Lat = next.Lat,
                Lon = next.Lon,
                Selected = true
            });

            // Aggiorniamo stato
            oraCorrente = fine;
            if (next.Lat.HasValue && next.Lon.HasValue) { lat = next.Lat.Value; lon = next.Lon.Value; }
            candidates.Remove(next);
        }

        // Popoliamo la proposta di anteprima con le nuove tappe (copia profonda minima)
        PropostaAnteprima = GiroProposto.Select(t => new TappaGiro {
            IdCliente = t.IdCliente,
            RagSociale = t.RagSociale,
            Citta = t.Citta,
            OrarioArrivo = t.OrarioArrivo,
            OrarioPartenza = t.OrarioPartenza,
            KmDaPuntoPrecedente = t.KmDaPuntoPrecedente,
            Lat = t.Lat,
            Lon = t.Lon,
            Selected = t.Selected
        }).ToList();

        showPreviewModal = true;
        StateHasChanged();
    }

    private bool possbileRientroExceeds(DateTime limite, DateTime possibile)
    {
        return possibile > limite;
    }

    private string GetTempoRimanenteString()
    {
        if (GiroProposto == null) return "--";
        var last = GiroProposto.Where(t => t.Selected).LastOrDefault();
        DateTime now = DataPianificazione.Date.Add(OrarioPartenzaPrevisto);
        if (last != null) now = DataPianificazione.Date.Add(last.OrarioPartenza.TimeOfDay);
        var limite = DataPianificazione.Date.Add(OrarioRientroMassimo);
        var remaining = limite - now;
        if (remaining.TotalMinutes <= 0) return "00:00";
        return $"{(int)remaining.TotalHours:D2}:{remaining.Minutes:D2}";
    }



    
