    private async Task SavePreviewToAgenda()
    {
        if (PropostaAnteprima == null) return;
        // Prima controlliamo conflitti: esistenti appuntamenti per gli stessi clienti nella stessa data
        using var db = new System.Data.SqlClient.SqlConnection(conn);
        string sqlExisting = @"SELECT IdAgenda, IdCliente, DataInizio, DataFine, Titolo FROM Agenda WHERE CONVERT(date, DataInizio) = @Data";
        var existing = (await db.QueryAsync(sqlExisting, new { Data = DataPianificazione.Date })).Select(r => new { IdAgenda = (int)r.IdAgenda, IdCliente = (int)r.IdCliente, DataInizio = (DateTime)r.DataInizio, DataFine = (DateTime)r.DataFine, Titolo = (string)r.Titolo }).ToList();

        // Costruiamo la lista di conflitti
        SaveConflicts = new List<ConflictItem>();
        foreach (var prop in PropostaAnteprima.Where(x => x.Selected))
        {
            var conflicts = existing.Where(e => e.IdCliente == prop.IdCliente).ToList();
            if (conflicts.Any())
            {
                SaveConflicts.Add(new ConflictItem { Proposed = prop, Existing = conflicts.Select(c => new ExistingAgenda { Titolo = c.Titolo, DataInizio = c.DataInizio, DataFine = c.DataFine }).ToList(), Save = false });
            }
        }

        if (SaveConflicts.Any())
        {
            // Mostriamo modal per scelta
            showConflictsModal = true;
            return;
        }

        // Nessun conflitto: salviamo direttamente
        string sqlInsert = @"INSERT INTO Agenda (IdCliente, DataInizio, DataFine, Titolo, Tipo, Dettaglio, IsChiuso, Priorita) VALUES (@IdCliente, @DataInizio, @DataFine, @Titolo, 'VISITA', @Dettaglio, 0, 1)";
        foreach (var t in PropostaAnteprima.Where(x => x.Selected))
        {
            DateTime inizio = DataPianificazione.Date.Add(t.OrarioArrivo.TimeOfDay);
            DateTime fine = DataPianificazione.Date.Add(t.OrarioPartenza.TimeOfDay);
            await db.ExecuteAsync(sqlInsert, new { IdCliente = t.IdCliente, DataInizio = inizio, DataFine = fine, Titolo = $"Visita: {t.RagSociale}", Dettaglio = "Giro riempito automaticamente" });
        }

        showPreviewModal = false;
        PropostaAnteprima = null;
        await JSRuntime.InvokeVoidAsync("alert", "Tappe salvate in Agenda.");
    }

