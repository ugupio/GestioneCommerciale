    private void CloseConflictsModal() { showConflictsModal = false; SaveConflicts = new List<ConflictItem>(); }

    private async Task ConfirmSaveConflicts()
    {
        using var db = new System.Data.SqlClient.SqlConnection(conn);
        string sqlInsert = @"INSERT INTO Agenda (IdCliente, DataInizio, DataFine, Titolo, Tipo, Dettaglio, IsChiuso, Priorita) VALUES (@IdCliente, @DataInizio, @DataFine, @Titolo, 'VISITA', @Dettaglio, 0, 1)";
        foreach (var sc in SaveConflicts.Where(x => x.Save))
        {
            var t = sc.Proposed;
            DateTime inizio = DataPianificazione.Date.Add(t.OrarioArrivo.TimeOfDay);
            DateTime fine = DataPianificazione.Date.Add(t.OrarioPartenza.TimeOfDay);
            await db.ExecuteAsync(sqlInsert, new { IdCliente = t.IdCliente, DataInizio = inizio, DataFine = fine, Titolo = $"Visita: {t.RagSociale}", Dettaglio = "Giro riempito automaticamente" });
        }

        CloseConflictsModal();
        showPreviewModal = false;
        PropostaAnteprima = null;
        await JSRuntime.InvokeVoidAsync("alert", "Salvataggio conflitti completato.");
    }

    private async Task NavigaWazeTappa(TappaGiro t)
    {
        if (t == null) return;
        // Usa lo stesso metodo usato in NuovaVisita: costruisci ricerca da indirizzo se lat/lon mancanti
        string ricerca = string.Empty;
        if (t.Lat.HasValue && t.Lon.HasValue)
        {
            ricerca = $"{t.Lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{t.Lon.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }
        else
        {
            // Prova a usare l'indirizzo concatenato: qui usiamo campo Citta come fallback
            ricerca = Uri.EscapeDataString($"{t.RagSociale}, {t.Citta}");
        }

        // Richiama la funzione JS definita in wwwroot/js/waze.js
        await JSRuntime.InvokeVoidAsync("waze.open", ricerca);
    }

    private async Task SalvaZona(Zona z)
    {
        try
        {
            using IDbConnection db = new SqlConnection(conn);
            if (z.IdZona == 0)
            {
                string sql = "INSERT INTO Zone (NomeZona, Descrizione) VALUES (@NomeZona, @Descrizione); SELECT CAST(SCOPE_IDENTITY() as int)";
                z.IdZona = await db.QuerySingleAsync<int>(sql, z);
            }
            else
            {
                string sql = "UPDATE Zone SET NomeZona = @NomeZona, Descrizione = @Descrizione WHERE IdZona = @IdZona";
                await db.ExecuteAsync(sql, z);
            }
            await JSRuntime.InvokeVoidAsync("alert", "Zona salvata con successo!");
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", "Errore: " + ex.Message); }
    }

    private async Task EliminaZona(Zona z)
    {
        if (z.IdZona == 0) { ListeZone.Remove(z); return; }

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Eliminare definitivamente la zona {z.NomeZona}?");
        if (confirm)
        {
            using IDbConnection db = new SqlConnection(conn);
            await db.ExecuteAsync("DELETE FROM Zone WHERE IdZona = @IdZona", new { z.IdZona });
            ListeZone.Remove(z);
        }
    }

