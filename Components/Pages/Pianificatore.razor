                                </td>
                                <td style="padding: 15px 10px; text-align: right; border: none;">
                                    <button @onclick="() => SelezionaCliente(cliente)" 
                                            style="background: #1e3c72; color: white; border: none; padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; transition: 0.3s;">
                                        AGGIUNGI
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer: Fisso in basso -->
            <div style="padding: 15px 30px; background: white; border-top: 1px solid #f1f5f9; text-align: right;">
                <button @onclick="ChiudiPopup" style="background: #f1f5f9; border: none; color: #475569; padding: 10px 25px; border-radius: 8px; font-weight: 700; cursor: pointer;">CHIUDI</button>
