private string GetColoreRow(object r)
{
    if (r is ManualPriceRow m)
    {
        var ci = m.ColoreInt ?? "";
        var ce = m.ColoreEst ?? "";
        if (string.IsNullOrWhiteSpace(ci) && string.IsNullOrWhiteSpace(ce)) return "";
        if (string.IsNullOrWhiteSpace(ce)) return ci;
        if (string.IsNullOrWhiteSpace(ci)) return ce;
        return $"{ci} / {ce}";
    }
    if (r is IDictionary<string, object> d)
    {
        var ci = d.TryGetValue("ColoreInt", out var v1) && v1 != null ? v1.ToString() ?? "" : "";
        var ce = d.TryGetValue("ColoreEst", out var v2) && v2 != null ? v2.ToString() ?? "" : "";
        if (string.IsNullOrWhiteSpace(ci) && string.IsNullOrWhiteSpace(ce)) return "";
        if (string.IsNullOrWhiteSpace(ce)) return ci;
        if (string.IsNullOrWhiteSpace(ci)) return ce;
        return $"{ci} / {ce}";
    }
    return "";
}

