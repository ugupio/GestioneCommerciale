private decimal GetPrezzoNettoRow(object r)
{
    if (r is ManualPriceRow m) return m.PrezzoNetto;
    var pu = GetPrezzoUnitarioRow(r);
    var sc = GetScontoRow(r);
    return Math.Round(pu * (1 - (sc / 100m)), 3);
}









