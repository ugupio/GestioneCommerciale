    private async Task SalvaManualRow(ManualPriceRow r)
    {
        if (r == null) return;
        // Validazioni semplici
        if (r.PrezzoUnitario < 0) r.PrezzoUnitario = 0;
        if (r.Quantita < 0) r.Quantita = 0;
        // Calcolo netto e persistenza su DB
        r.IsEditing = false;
        try
        {
            using var db = new SqlConnection(conn);
            // Ensure table exists (in case this page was not inizialized earlier)
            var ensureSql = @"IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[PriceHistory]') AND type = 'U')
BEGIN
    CREATE TABLE dbo.PriceHistory (
        PriceHistoryId INT IDENTITY(1,1) PRIMARY KEY,
        CodiceProdotto NVARCHAR(100) NOT NULL,
        DataOrdine DATE NOT NULL,
        RagSociale NVARCHAR(250) NOT NULL,
        Quantita DECIMAL(18,3) NOT NULL DEFAULT 0,
        UmRiga NVARCHAR(20) NULL,
        ColoreInt NVARCHAR(100) NULL,
        ColoreEst NVARCHAR(100) NULL,
        FinituraAccessorio NVARCHAR(200) NULL,
        PrezzoUnitario DECIMAL(18,6) NOT NULL DEFAULT 0,
        Sconto DECIMAL(5,2) NOT NULL DEFAULT 0,
        PrezzoNetto DECIMAL(18,6) NOT NULL DEFAULT 0,
        Note NVARCHAR(400) NULL,
        InseritoDa NVARCHAR(100) NULL,
        InseritoIl DATETIME2 NOT NULL DEFAULT SYSUTCDATETIME()
    );
END
IF NOT EXISTS (SELECT name FROM sys.indexes WHERE name = 'IX_PriceHistory_Codice_Data' AND object_id = OBJECT_ID('dbo.PriceHistory'))
BEGIN
    CREATE INDEX IX_PriceHistory_Codice_Data ON dbo.PriceHistory(CodiceProdotto, InseritoIl DESC);
END";
            try { db.Execute(ensureSql); } catch { /* non blocking */ }

            if (r.PriceHistoryId == 0)
            {
                var insertSql = @"INSERT INTO PriceHistory (CodiceProdotto, DataOrdine, RagSociale, Quantita, UmRiga, ColoreInt, ColoreEst, FinituraAccessorio, PrezzoUnitario, Sconto, PrezzoNetto, InseritoDa)
                                   VALUES (@CodiceProdotto, @DataOrdine, @RagSociale, @Quantita, @UmRiga, @ColoreInt, @ColoreEst, @FinituraAccessorio, @PrezzoUnitario, @Sconto, @PrezzoNetto, @InseritoDa);
                                   SELECT CAST(SCOPE_IDENTITY() as int);";
                var id = db.ExecuteScalar<int>(insertSql, new
                {
                    CodiceProdotto = prodottoSelezionatoRadar?.CodiceProdotto ?? "",
                    r.DataOrdine,
                    r.RagSociale,
                    r.Quantita,
                    r.UmRiga,
                    r.ColoreInt,
                    r.ColoreEst,
                    r.FinituraAccessorio,
                    r.PrezzoUnitario,
                    r.Sconto,
                    PrezzoNetto = r.PrezzoNetto,
                    InseritoDa = Environment.UserName
                });
                r.PriceHistoryId = id;
                try { await JS.InvokeVoidAsync("console.log", $"PriceHistory: inserita riga id={id} codice={prodottoSelezionatoRadar?.CodiceProdotto} prezzo={r.PrezzoUnitario}"); } catch { }
            }
            else
            {
                var upd = @"UPDATE PriceHistory SET DataOrdine=@DataOrdine, RagSociale=@RagSociale, Quantita=@Quantita, UmRiga=@UmRiga, ColoreInt=@ColoreInt, ColoreEst=@ColoreEst, FinituraAccessorio=@FinituraAccessorio, PrezzoUnitario=@PrezzoUnitario, Sconto=@Sconto, PrezzoNetto=@PrezzoNetto WHERE PriceHistoryId=@PriceHistoryId";
                db.Execute(upd, new
                {
                    r.DataOrdine,
                    r.RagSociale,
                    r.Quantita,
                    r.UmRiga,
                    r.ColoreInt,
                    r.ColoreEst,
                    r.FinituraAccessorio,
                    r.PrezzoUnitario,
                    r.Sconto,
                    PrezzoNetto = r.PrezzoNetto,
                    r.PriceHistoryId
                });
                try { await JS.InvokeVoidAsync("console.log", $"PriceHistory: aggiornata riga id={r.PriceHistoryId} codice={prodottoSelezionatoRadar?.CodiceProdotto} prezzo={r.PrezzoUnitario}"); } catch { }
            }
        }
        catch (Exception ex)
        {
            messaggioInfo = "Errore salvataggio storico: " + ex.Message;
        }
        StateHasChanged();
    }

    private void AnnullaEditManualRow(ManualPriceRow r)
    {
        if (r == null) return;
        // Se nuovo e annulli, rimuovi
        if (r.IDOrdine == 0 && (r.PrezzoUnitario == 0m && string.IsNullOrWhiteSpace(r.FinituraAccessorio) && r.Quantita == 0))
        {
            listaRisultatiRadar.Remove(r);
        }
        else
        {
            r.IsEditing = false;
        }
    }

    private async Task EliminaManualRow(ManualPriceRow r)
    {
        if (r == null) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Eliminare la voce manuale?")) return;
        // Determine a persistent id in a robust way (ManualPriceRow.PriceHistoryId or dynamic property)
        int idToDelete = 0;
        try
        {
            idToDelete = r.PriceHistoryId;
        }
        catch { /* ignore */ }

        // Also support cases where the item in the list is a dynamic/IDictionary loaded from DB
        if (idToDelete == 0 && r is IDictionary<string, object> dict && dict.TryGetValue("PriceHistoryId", out var v) && v != null)
        {
            try { idToDelete = Convert.ToInt32(v); } catch { idToDelete = 0; }
        }

        if (idToDelete != 0)
        {
            try
            {
                using var db = new SqlConnection(conn);
                var deleted = await db.ExecuteAsync("DELETE FROM PriceHistory WHERE PriceHistoryId = @id", new { id = idToDelete });
                if (deleted == 0)
                {
                    await JS.InvokeVoidAsync("alert", "Attenzione: nessuna riga eliminata in DB (id non trovato).");
                    return;
                }
            }
            catch (Exception ex)
            {
                try { await JS.InvokeVoidAsync("alert", "Errore eliminazione da DB: " + ex.Message); } catch { }
                return; // abort removal from UI if DB delete failed
            }

            // After successful DB delete reload the results to reflect DB state
            await EseguiRicercaRadar();
            StateHasChanged();
            return;
        }

        // If no persistent id, just remove the in-memory row
        listaRisultatiRadar.Remove(r);
        StateHasChanged();
    }




