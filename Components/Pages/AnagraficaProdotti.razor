private async Task EseguiRicercaRadar()
{
    if (prodottoSelezionatoRadar == null) return;
    using var db = new SqlConnection(conn);
    
    string sql = @"
        SELECT 
            O.DataOrdine, 
            D.IDOrdine,
            C.RagSociale, 
            D.Quantita, 
            D.ColoreInt, 
            D.ColoreEst, 
            D.FinituraAccessorio, 
            C.Cel1, 
            D.UmRiga, 
            D.PrezzoUnitario,
            D.ScontoRiga AS Sconto, -- Mappato come 'Sconto' per la UI
            -- Calcolo BI: Prezzo scontato con precisione a 3 decimali
            CAST(D.PrezzoUnitario * (1 - (ISNULL(D.ScontoRiga, 0) / 100)) AS DECIMAL(18,3)) AS PrezzoNetto
        FROM Dettaglio_Ordini D
        JOIN Ordini O ON D.IDOrdine = O.IDOrdine
        JOIN Clienti C ON O.IDCliente = C.IdCliente
        WHERE LTRIM(RTRIM(D.CodiceProdotto)) = LTRIM(RTRIM(@Codice))
        ORDER BY O.DataOrdine DESC";

    var result = await db.QueryAsync(sql, new { Codice = prodottoSelezionatoRadar.CodiceProdotto });
    listaRisultatiRadar = result.ToList();
    // Carichiamo anche le righe manuali da PriceHistory e le inseriamo in testa
        try
        {
            var manualsFromDb = (await db.QueryAsync(@"SELECT PriceHistoryId AS PriceHistoryId, CodiceProdotto, DataOrdine, RagSociale, Quantita, UmRiga, ColoreInt, ColoreEst, FinituraAccessorio, PrezzoUnitario, Sconto, PrezzoNetto FROM PriceHistory WHERE LTRIM(RTRIM(CodiceProdotto)) = LTRIM(RTRIM(@Codice)) ORDER BY InseritoIl DESC", new { Codice = prodottoSelezionatoRadar.CodiceProdotto }))
            .Select(d => new ManualPriceRow
            {
                PriceHistoryId = (int)(d.PriceHistoryId ?? 0),
                DataOrdine = d.DataOrdine ?? DateTime.Today,
                RagSociale = d.RagSociale ?? "Listino",
                Quantita = d.Quantita ?? 0m,
                UmRiga = d.UmRiga ?? prodottoSelezionatoRadar?.UmProdotto ?? "PZ",
                ColoreInt = d.ColoreInt ?? "",
                ColoreEst = d.ColoreEst ?? "",
                FinituraAccessorio = d.FinituraAccessorio ?? "",
                PrezzoUnitario = d.PrezzoUnitario ?? 0m,
                Sconto = d.Sconto ?? 0m,
                IsEditing = false
            }).Cast<dynamic>().ToList();

        if (manualsFromDb.Any()) listaRisultatiRadar.InsertRange(0, manualsFromDb);
    }
    catch { /* ignore if table not present yet */ }
    // Manteniamo eventuali righe manuali già aggiunte: se presenti, riattacchiamole in testa
    var manuals = listaRisultatiRadar.Where(x => x is ManualPriceRow).ToList();
    listaRisultatiRadar = listaRisultatiRadar.Where(x => !(x is ManualPriceRow)).ToList();
    if (manuals.Any()) listaRisultatiRadar.InsertRange(0, manuals);
}

