@using GestioneCommerciale.Models
@using System.Data.SqlClient
@using Dapper
@using Radzen
@inject DialogService DialogService

<style>
	.task-modal {
		border-radius: 12px;
		background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(250,250,250,0.98));
		box-shadow: 0 12px 30px rgba(2,6,23,0.35);
		overflow: hidden;
	}
	.task-modal-header {
		padding: 18px 20px;
		background: linear-gradient(90deg, #1e90ff 0%, #00b4d8 100%);
		color: white;
		display:flex;
		align-items:center;
		gap:12px;
	}
	.task-modal-header .icon {
		font-size: 1.6rem;
		background: rgba(255,255,255,0.12);
		padding: 8px 10px;
		border-radius: 8px;
	}
	.task-modal-body { padding: 18px; }
	.priority-badge { padding:6px 10px; border-radius:999px; color:#fff; font-weight:600; font-size:0.85rem; }
	.task-footer { padding: 12px 18px; background: linear-gradient(180deg, rgba(0,0,0,0.02), transparent); }
</style>

@code {
	[Parameter] public Attivita Task { get; set; }
	[Parameter] public List<Cliente> ListaClienti { get; set; }
	[Parameter] public string Conn { get; set; }

	private string GetPriorityColor(int p) => p switch { 3 => "#ef476f", 2 => "#ffb703", _ => "#06d6a0" };
	private string GetPriorityText(int p) => p switch { 3 => "Alta", 2 => "Media", _ => "Bassa" };

	private string DateValue => Task?.DataScadenza.ToString("yyyy-MM-ddTHH:mm") ?? DateTime.Now.ToString("yyyy-MM-ddTHH:mm");

	private async Task Salva()
	{
		using var db = new SqlConnection(Conn);
		if (Task.IDAttivita > 0)
		{
			await db.ExecuteAsync("UPDATE Attivita SET Descrizione = @Descrizione, DataScadenza = @DataScadenza, Completata = @Completata, Priorita = @Priorita, IDClienteAttivita = @IDClienteAttivita WHERE IDAttivita = @IDAttivita", Task);
		}
		else
		{
			await db.ExecuteAsync("INSERT INTO Attivita (Descrizione, DataScadenza, Completata, Priorita, IDClienteAttivita) VALUES (@Descrizione, @DataScadenza, @Completata, @Priorita, @IDClienteAttivita)", Task);
		}

		DialogService.Close(true);
	}

	private void Annulla() => DialogService.Close(false);
}

<div class="task-modal">
	<div class="task-modal-header">
		<div class="icon">📌</div>
		<div style="flex-grow:1">
			<div style="font-weight:700; font-size:1.05rem">Modifica Task</div>
			<div style="font-size:0.85rem; opacity:0.9">Modifica i dettagli e salva per aggiornare l'agenda</div>
		</div>
		<div class="priority-badge" style="background:@GetPriorityColor(Task?.Priorita ?? 1)">@GetPriorityText(Task?.Priorita ?? 1)</div>
	</div>

	<div class="task-modal-body">
		<div class="row gx-3">
			<div class="col-md-8">
				<div class="mb-3">
					<label class="form-label">Descrizione</label>
					<textarea class="form-control" rows="4" maxlength="500" placeholder="Inserisci una descrizione sintetica ma significativa" @bind="Task.Descrizione"></textarea>
					<small class="text-muted">Max 500 caratteri. Questa descrizione sarà mostrata nell'agenda.</small>
				</div>

				<div class="mb-3">
					<label class="form-label">Cliente (opzionale)</label>
					<select class="form-select" @bind="Task.IDClienteAttivita">
						<option value="">-- Nessuno --</option>
						@if (ListaClienti != null)
						{
							foreach (var c in ListaClienti)
							{
								<option value="@c.IdCliente">@c.RagSociale</option>
							}
						}
					</select>
					<small class="text-muted">Collega il task a un cliente per vedere il nome direttamente nell'agenda.</small>
				</div>
			</div>

			<div class="col-md-4">
				<div class="mb-3">
					<label class="form-label">Scadenza</label>
					<input type="datetime-local" class="form-control" value='@DateValue' @onchange="@(e => { if(DateTime.TryParse(e.Value?.ToString(), out var d)) Task.DataScadenza = d; })" />
					<small class="text-muted">Scegli data e ora di scadenza.</small>
				</div>

				<div class="mb-3">
					<label class="form-label d-block">Priorità</label>
					<div class="d-flex gap-2">
						<button type="button" class="btn @(Task?.Priorita == 1 ? "btn-success" : "btn-outline-secondary")" @onclick="() => Task.Priorita = 1">Bassa</button>
						<button type="button" class="btn @(Task?.Priorita == 2 ? "btn-warning" : "btn-outline-secondary")" @onclick="() => Task.Priorita = 2">Media</button>
						<button type="button" class="btn @(Task?.Priorita == 3 ? "btn-danger" : "btn-outline-secondary")" @onclick="() => Task.Priorita = 3">Alta</button>
					</div>
					<small class="text-muted d-block mt-1">Usa la priorità per ordinare attività urgenti.</small>
				</div>

				<div class="form-check mt-2">
					<input class="form-check-input" type="checkbox" id="chkComp" @bind="Task.Completata" />
					<label class="form-check-label" for="chkComp">Marca come completata</label>
					<div><small class="text-muted">Se selezionato il task verrà escluso dall'elenco attivo.</small></div>
				</div>
			</div>
		</div>
	</div>

	<div class="task-footer d-flex justify-content-end gap-2">
		<button class="btn btn-outline-secondary" style="border-radius:10px;" @onclick="Annulla">Annulla</button>
		<button class="btn btn-primary" style="border-radius:10px; padding-left:18px; padding-right:18px;" @onclick="Salva">Salva</button>
	</div>
</div>
