@page "/nuovo-reso"
@rendermode InteractiveServer
@using System.Data.SqlClient
@using Dapper
@using GestioneCommerciale.Models
@inject NavigationManager Nav
@inject IJSRuntime JS
@using QuestPDF.Fluent
@using Radzen
@using Radzen.Blazor
@inject DialogService DialogService


<style>
    .win-form { background-color: #f0f0f0; font-family: 'Segoe UI', Tahoma, sans-serif; font-size: 11px; border: 1px solid #999; padding: 5px; min-width: 1000px; color: #333; position: relative; min-height: 98vh; }
    .win-header { background: #005a9e; color: white; padding: 3px 8px; font-weight: bold; margin: -5px -5px 5px -5px; font-size: 12px; }
    .win-group { border: 1px solid #c0c0c0; background: #fff; padding: 8px; margin-bottom: 5px; }
    .win-label { font-weight: 500; color: #333; font-size: 10px; display: block; margin-bottom: 2px; }
    .win-input { border: 1px solid #ccc; padding: 1px 4px; height: 21px; width: 100%; font-size: 11px; }
    .toolbar-container { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 5px; background: #fdfdfd; border: 1px solid #c0c0c0; margin-bottom: 5px; }
    .win-grid { width: 100%; border-collapse: collapse; background: white; font-size: 10.5px; }
    .win-grid th { background: #f0f0f0; border: 1px solid #ccc; padding: 4px; text-align: left; }
    .win-grid td { border: 1px solid #eee; padding: 2px 4px; }
    .section-title { font-weight: bold; color: #005a9e; border-bottom: 1px solid #ddd; margin-bottom: 8px; font-size: 10px; text-transform: uppercase; }
    .toast-msg { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); background: #333; color: white; padding: 12px 30px; border-radius: 3px; z-index: 9999; border-left: 5px solid #dc3545; }
    .win-grid {
        background-color: white !important;
        color: #333 !important;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }
    .win-grid thead th {
        background-color: #f8f9fa !important;
        color: #1e3c72 !important;
        border-bottom: 2px solid #1e3c72;
        position: sticky;
        top: 0;
    }

    /* STILE PREMIUM TALL - GESTIONE RESI */
    .btn-comando-ordine {
        height: 90px !important;
        min-width: 95px !important;
        display: inline-flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 5px !important;
        padding: 10px !important;
        background: #ffffff !important;
        color: #1e3c72 !important;
        font-weight: bold !important;
        border: 2px solid #ffffff !important;
        border-radius: 12px !important;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1) !important;
        transition: all 0.2s ease-in-out !important;
        cursor: pointer !important;
        text-transform: uppercase;
        font-size: 10px !important;
    }

    .btn-comando-ordine:hover {
        background: #00d2ff !important;
        color: white !important;
        border-color: #00d2ff !important;
        transform: scale(1.05) !important;
        box-shadow: 0 0 20px rgba(0, 210, 255, 0.6) !important;
    }

    .btn-comando-ordine span:first-child { font-size: 2rem !important; pointer-events: none !important; }
    .btn-start-nav { background: #f8f9fa !important; border-color: #dee2e6 !important; }
    .btn-start-verde { background: #d4edda !important; border-color: #28a745 !important; }
    .btn-start-rosso { background: #f8d7da !important; border-color: #dc3545 !important; color: #721c24 !important; }

    .search-wrapper-premium {
        display: flex; align-items: center; background: white;
        border: 2px solid #ffffff; border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1); height: 90px; overflow: hidden;
    }
    .search-input-premium {
        border: none !important; padding: 0 20px !important; font-size: 16px !important;
        flex-grow: 1; outline: none !important; height: 100%; color: #1e3c72;
    }
    .search-btn-premium {
        background: #f8f9fa; border: none; width: 70px; height: 100%;
        cursor: pointer; font-size: 1.5rem; border-left: 1px solid #eee;
    }
</style>

<div class="win-form">
    <div class="win-header">Gestione Resi Merce - by Riccardo Gucci soft.</div>

    <!-- TOOLBAR -->
    <div class="toolbar-container">
    <!-- NAVIGAZIONE -->
    <div style="display:flex; gap:5px; flex-shrink: 0;">
        <button class="btn-comando-ordine btn-start-nav" @onclick='() => Nav.NavigateTo("/")'>
            <span>🏠</span><span>HOME</span>
        </button>
        @* PREC: va verso i resi più vecchi (indice sale: 0 -> 1 -> 2) *@
<button class="btn-comando-ordine btn-start-nav" @onclick="Prev" 
        disabled="@(indiceCorrente >= listaIdResi.Count - 1)">
    <span>◀</span><span>PREC.</span>
</button>

@* SUCC: va verso i resi più nuovi (indice scende: 2 -> 1 -> 0) *@
<button class="btn-comando-ordine btn-start-nav" @onclick="Next" 
        disabled="@(indiceCorrente <= 0)">
    <span>▶</span><span>SUCC.</span>
</button>
    </div>

    <!-- RICERCA RESI -->
    <div style="flex-grow: 1; min-width: 200px;">
        <div class="search-wrapper-premium">
            <input type="text" class="search-input-premium" placeholder="Cerca Numero Reso o Cliente..." @bind="testoRicerca" />
            <button class="search-btn-premium" @onclick="EseguiRicerca">🔍</button>
        </div>
    </div>

    <!-- AZIONI RESO -->
    <div style="display:flex; gap:5px; flex-shrink: 0;">
        <button class="btn-comando-ordine" @onclick="IniziaNuovo">
            <span>🔄➕</span><span>NUOVO RESO</span>
        </button>
        
        <button class="btn-comando-ordine btn-start-verde" @onclick="SalvaTutto">
            <span>💾</span><span>SALVA</span>
        </button>

        <button class="btn-comando-ordine" style="background:#fffde7 !important;" @onclick="StampaDocumentoReso">
            <span>📄</span><span>STAMPA</span>
        </button>

        @if(reso.IDReso > 0) {
            <button class="btn-comando-ordine btn-start-rosso" @onclick="EliminaReso">
                <span>🗑️</span><span>ELIMINA</span>
            </button>
        }
    </div>
</div>


    <!-- TESTATA -->
    <div class="win-group">
        <div class="section-title">Dati Identificativi Reso</div>
        <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 8px;">
            <div>
                <label class="win-label">Cliente</label>
                <select class="win-input" value="@reso.IDCliente" @onchange="OnClienteChanged">
                    <option value="0">-- Seleziona Cliente --</option>
                    @foreach (var c in listaClienti) { <option value="@c.IdCliente">@c.RagSociale</option> }
                </select>
            </div>
            <div><label class="win-label">Data Reso</label><input type="date" class="win-input" @bind="dataSolo" /></div>
            <div>
    <label class="win-label">Rif. Ordine</label>
    <div style="display: flex; gap: 4px; align-items: center;">
        <select class="win-input" @bind="reso.IDOrdine" style="flex-grow: 1; height: 21px;">
        <option value="0">-- Nessun ordine --</option>
        @foreach (var o in listaOrdiniCliente) { 
            <option value="@o.IDOrdine">@o.NumeroDocumento</option> 
        }
    </select>

    @* Pulsante con le 3 righe (≡) *@
    <button type="button" class="win-btn" 
            style="width: 30px; background: #0078d7; color: white; height: 21px; padding: 0; font-weight: bold; font-size: 1.1rem; line-height: 1;" 
            @onclick="ApriModale" 
            disabled="@(reso.IDOrdine == 0)">
        &#8801;
    </button>
    </div>
</div>

            <div>
                <label class="win-label">Stato Reso</label>
                <select class="win-input" @bind="reso.StatoReso">
                    <option value="Aperto">Aperto</option>
                    <option value="Inviato">Inviato</option>
                    <option value="Ricevuto">Ricevuto</option>
                </select>
            </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px;">
            <div><label class="win-label">Motivazione</label><input type="text" class="win-input" @bind="reso.Motivazione" /></div>
            <div><label class="win-label">Aspetto Merce</label><input type="text" class="win-input" @bind="reso.Aspetto" /></div>
        </div>
    </div>

    <!-- INSERIMENTO RIGA -->
    <div class="win-group" style="background: #fff5f5; border-left: 5px solid #dc3545;">
        <div class="section-title" style="color: #dc3545;">Aggiungi Articolo al Reso</div>
        <div style="display: grid; grid-template-columns: 1fr 2fr 80px 100px; gap: 5px; align-items: end;">
            <div><label class="win-label">Codice</label><input class="win-input" @bind="nuovaRiga.Codice" /></div>
            <div><label class="win-label">Descrizione</label><input class="win-input" @bind="nuovaRiga.Descrizione" /></div>
            <div><label class="win-label">Quantità</label><input type="number" class="win-input" @bind="nuovaRiga.Quantita" /></div>
            <button class="win-btn" style="background:#dc3545; color:white; height:21px;" @onclick="AggiungiRiga">INSERISCI</button>
        </div>
    </div>

    <!-- GRIGLIA RIGHE -->
    <div class="win-group" style="height: 250px; overflow-y: auto; padding:0; border: 1px solid #ddd;">
    <table class="win-grid" style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
        <thead style="position: sticky; top: 0; background: #f8f9fa; z-index: 1;">
            <tr style="border-bottom: 2px solid #dee2e6;">
                <th style="width:120px; padding: 8px; text-align: left;">Codice</th>
                <th style="padding: 8px; text-align: left;">Descrizione Merce</th>
                <th style="width:100px; padding: 8px; text-align: right;">Q.tà</th>
                <th style="width:150px; padding: 8px; text-align: left;">Stato</th>
                <th style="width:40px; padding: 8px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in righeReso) {
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 5px; color: #666; font-weight: bold;">@r.Codice</td>
                    
                    <td style="padding: 5px;">
                        <div style="font-size: 0.85rem; color: #333;">@r.Descrizione</div>
                        <div style="font-size: 0.75rem; color: #999;">
                            @(r.IsAccessorio ? r.FinituraAccessorio : $"{r.ColoreInt} / {r.ColoreEst}")
                        </div>
                    </td>

                    <td style="padding: 5px; text-align: right;">
                        <span style="font-weight: bold;">@r.Quantita</span>
                        <span style="font-size: 0.75rem; color: #666; margin-left: 3px;">@r.UmRiga</span>
                    </td>

                    <td style="padding: 5px; font-size: 0.8rem; color: #555;">
                        @(string.IsNullOrWhiteSpace(r.StatoBene) ? "-" : r.StatoBene)
                    </td>

                    <td style="padding: 5px; text-align: center;">
                        <button class="border-0 bg-transparent text-danger" 
                                @onclick="() => righeReso.Remove(r)" 
                                style="cursor: pointer; font-size: 1rem;">✖</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


    @if (mostraMessaggio) { <div class="toast-msg">@testoNotifica</div> }
</div>

@if (showModale)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; border: 2px solid #0078d7; width: 80%; max-width: 700px; padding: 15px; box-shadow: 5px 5px 15px rgba(0,0,0,0.3);">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ddd; padding-bottom: 10px; margin-bottom: 10px;">
                <strong style="color: #0078d7;">SELEZIONA RIGHE ORDINE : @riferimentoOrdine</strong>
                <button @onclick="() => showModale = false" style="background:none; border:none; cursor:pointer;">✖</button>
            </div>

            <div style="max-height: 350px; overflow-y: auto;">
                <table class="win-grid" style="width: 100%;">
                    <thead>
                        <tr>
                            <th style="width:30px;"></th>
                            <th>Codice</th>
                            <th>Descrizione</th>
                            <th class="text-end">Q.tà</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in righeOrdinePopup)
                        {
                            <tr @onclick="() => { if(!selezionate.Contains(r)) selezionate.Add(r); else selezionate.Remove(r); }" style="cursor:pointer; background: @(selezionate.Contains(r) ? "#eef6ff" : "white")">
                                <td><input type="checkbox" checked="@selezionate.Contains(r)" /></td>
                                <td>@r.CodiceProdotto</td>
                                <td>@r.Descrizione</td>
                                <td class="text-end">@r.Quantita</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="text-align: right; margin-top: 15px;">
                <button class="win-btn" style="background: #ccc; margin-right: 5px;" @onclick="() => showModale = false">ANNULLA</button>
                <button class="win-btn" style="background: #28a745; color: white;" @onclick="ChiudiEInserisci">INSERISCI (@selezionate.Count)</button>
            </div>
        </div>
    </div>
}


@code {
    private Reso reso = new() { DataReso = DateTime.Now, StatoReso = "Aperto" };
    private DettaglioReso nuovaRiga = new() { Quantita = 1 };
    private List<DettaglioReso> righeReso = new();
    private List<Cliente> listaClienti = new();
    private List<int> listaIdResi = new();
    private List<Ordine> listaOrdiniCliente = new();
    private int indiceCorrente = -1;
    private DateTime dataSolo = DateTime.Now;
    private string testoNotifica = "";
    private bool mostraMessaggio = false;
    private string conn = @"Server=.\SQLEXPRESS;Database=GestAgenti;Trusted_Connection=True;TrustServerCertificate=True;";
    private string testoRicerca = "";
    // Questa lista conterrà le righe che l'utente spunta nel popup
    private List<DettaglioOrdine> righeSelezionate = new();


    protected override async Task OnInitializedAsync() {
    using var db = new SqlConnection(conn);
    
    // AGGIORNATA: Ora scarichiamo tutti i campi necessari per l'indirizzo e la P.IVA
    string sql = @"SELECT IdCliente, RagSociale, Ind_legale, CAP_Legale, 
                          Citta_Legale, Prov_Legale, PIva 
                   FROM Clienti 
                   ORDER BY RagSociale";
    
    listaClienti = (await db.QueryAsync<Cliente>(sql)).ToList();
    
    await CaricaListaID();
    if (listaIdResi.Any()) { 
        indiceCorrente = 0; 
        await CaricaReso(listaIdResi[indiceCorrente]); 
    }
}


    
    
    
    
    private void EseguiRicerca()
    {
        // Qui scriverai la logica per filtrare i resi, per ora la lasciamo pronta
    }

    private void CercaEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") EseguiRicerca();
    }
    
    
    private async Task CaricaListaID() {
        using var db = new SqlConnection(conn);
        listaIdResi = (await db.QueryAsync<int>("SELECT IDReso FROM Resi ORDER BY DataReso DESC")).ToList();
    }

    private async Task CaricaReso(int id) {
    using var db = new SqlConnection(conn);
    var loaded = await db.QueryFirstOrDefaultAsync<Reso>("SELECT * FROM Resi WHERE IDReso = @id", new { id });
    
    if (loaded is null) {
        reso = new Reso { IDReso = 0, DataReso = DateTime.Now, StatoReso = "Aperto" };
    } else {
        reso = loaded;
    }
    
    dataSolo = reso.DataReso ?? DateTime.Now;

    var rows = await db.QueryAsync<DettaglioReso>("SELECT * FROM DettagliReso WHERE IDReso = @id", new { id });
    
    righeReso = rows?.Select(x => new DettaglioReso 
    { 
        IDRigaReso = x.IDRigaReso,
        IDReso = x.IDReso,
        Codice = x.Codice, 
        Descrizione = x.Descrizione, 
        Quantita = x.Quantita,
        UmRiga = x.UmRiga,
        IsAccessorio = x.IsAccessorio,
        FinituraAccessorio = x.FinituraAccessorio,
        ColoreInt = x.ColoreInt,
        ColoreEst = x.ColoreEst,
        StatoBene = x.StatoBene 
    }).ToList() ?? new List<DettaglioReso>();

    await CaricaOrdiniCliente(reso.IDCliente);

    // --- SINCRONIZZAZIONE INDICE PER NAVIGAZIONE ---
    if (listaIdResi != null && listaIdResi.Contains(id))
    {
        indiceCorrente = listaIdResi.IndexOf(id);
    }
    
    // Notifica a Blazor che i dati (e lo stato dei pulsanti) sono cambiati
    StateHasChanged();
}



    private async Task CaricaOrdiniCliente(int idCliente) {
        listaOrdiniCliente.Clear();
        if (idCliente <= 0) return;
        using var db = new SqlConnection(conn);
        // show only documents that are actual orders (StatoOrdine = 'Ordine')
        var rows = await db.QueryAsync<Ordine>("SELECT IDOrdine, IDCliente, DataOrdine, NumeroDocumento, StatoOrdine FROM Ordini WHERE IDCliente = @id AND StatoOrdine = 'Ordine' ORDER BY DataOrdine DESC", new { id = idCliente });
        listaOrdiniCliente = rows.ToList();
        // if current selected ordine not in list, reset to 0
        if (reso.IDOrdine.HasValue && !listaOrdiniCliente.Any(o => o.IDOrdine == reso.IDOrdine.Value)) reso.IDOrdine = null;
    }

    private async Task OnClienteChanged(ChangeEventArgs e) {
        if (e?.Value is null) return;
        if (int.TryParse(e.Value.ToString(), out var id)) {
            reso.IDCliente = id;
            // clear selected order when client changes
            reso.IDOrdine = null;
            await CaricaOrdiniCliente(reso.IDCliente);
            StateHasChanged();
        }
    }

    private void AggiungiRiga() {
        if (string.IsNullOrEmpty(nuovaRiga.Codice)) return;
        righeReso.Add(new DettaglioReso { Codice = nuovaRiga.Codice, Descrizione = nuovaRiga.Descrizione, Quantita = nuovaRiga.Quantita });
        nuovaRiga = new DettaglioReso { Quantita = 1 };
    }

    private async Task SalvaTutto() {
    if (reso.IDCliente == 0) { await Notifica("⚠️ Seleziona un cliente!"); return; }
    
    using var db = new SqlConnection(conn);
    await db.OpenAsync();
    using var tx = db.BeginTransaction();
    
    try {
        reso.DataReso = dataSolo;
        if (reso.IDOrdine == 0) reso.IDOrdine = null;

        // 1. Salvataggio Testata
        string sqlReso = (reso.IDReso == 0) 
            ? "INSERT INTO Resi (IDCliente, IDOrdine, DataReso, StatoReso, Motivazione, Aspetto) OUTPUT INSERTED.IDReso VALUES (@IDCliente, @IDOrdine, @DataReso, @StatoReso, @Motivazione, @Aspetto)"
            : "UPDATE Resi SET IDCliente=@IDCliente, IDOrdine=@IDOrdine, DataReso=@DataReso, StatoReso=@StatoReso, Motivazione=@Motivazione, Aspetto=@Aspetto WHERE IDReso=@IDReso";
        
        if (reso.IDReso == 0) reso.IDReso = await db.QuerySingleAsync<int>(sqlReso, reso, tx);
        else await db.ExecuteAsync(sqlReso, reso, tx);

        // 2. Pulizia (usa il nome tabella corretto: DettagliReso)
        await db.ExecuteAsync("DELETE FROM DettagliReso WHERE IDReso = @id", new { id = reso.IDReso }, tx);

        // 3. Inserimento Righe (un solo ciclo!)
        foreach (var r in righeReso) {
            await db.ExecuteAsync(@"INSERT INTO DettagliReso 
                (IDReso, Codice, Descrizione, Quantita, UmRiga, IsAccessorio, FinituraAccessorio, ColoreInt, ColoreEst, StatoBene) 
                VALUES 
                (@IDReso, @Codice, @Descrizione, @Quantita, @UmRiga, @IsAccessorio, @FinituraAccessorio, @ColoreInt, @ColoreEst, @StatoBene)", 
                new { 
                    IDReso = reso.IDReso, 
                    r.Codice, // Ora salva il codice vero del prodotto!
                    r.Descrizione, 
                    r.Quantita,
                    r.UmRiga,
                    r.IsAccessorio,
                    r.FinituraAccessorio,
                    r.ColoreInt,
                    r.ColoreEst,
                    r.StatoBene
                }, tx);
        }

        tx.Commit();
        await Notifica("✅ Reso salvato con successo!");
        
        // 1. Ricarica la lista degli ID dal database per includere il nuovo record
        await CaricaListaID(); 

        // 2. SINCRONIZZAZIONE: Trova dove si trova il reso salvato nella lista aggiornata
        if (listaIdResi != null && reso.IDReso > 0)
        {
            indiceCorrente = listaIdResi.IndexOf(reso.IDReso);
        }

        // 3. Notifica a Blazor di ricalcolare lo stato dei pulsanti (disabled/enabled)
        StateHasChanged(); 

    } catch (Exception ex) { 
        tx.Rollback(); 
        await Notifica("❌ Errore: " + ex.Message); 
    }
}


    private async Task EliminaReso() {
        if (!await JS.InvokeAsync<bool>("confirm", "Eliminare il reso?")) return;
        using var db = new SqlConnection(conn);
        // use the same detail table used elsewhere
        await db.ExecuteAsync("DELETE FROM DettagliReso WHERE IDReso = @id", new { id = reso.IDReso });
        await db.ExecuteAsync("DELETE FROM Resi WHERE IDReso = @id", new { id = reso.IDReso });
        await CaricaListaID();
        if (listaIdResi.Any()) { indiceCorrente = 0; await CaricaReso(listaIdResi[0]); } else IniziaNuovo();
    }

    private async Task Notifica(string msg) { testoNotifica = msg; mostraMessaggio = true; StateHasChanged(); await Task.Delay(3000); mostraMessaggio = false; StateHasChanged(); }
    private async Task IniziaNuovo() { 
        if (!await JS.InvokeAsync<bool>("confirm", "Creare un nuovo reso e perdere le modifiche non salvate?")) return;
        reso = new Reso { DataReso = DateTime.Now, StatoReso = "Aperto" }; righeReso.Clear(); indiceCorrente = -1; }

    private async Task Annulla() {
        if (!await JS.InvokeAsync<bool>("confirm", "Annullare le modifiche non salvate?")) return;
        if (reso.IDReso == 0) { IniziaNuovo(); return; }
        await CaricaReso(reso.IDReso);
    }
    private async Task Prev() 
{ 
    if (listaIdResi != null && indiceCorrente < listaIdResi.Count - 1) 
    { 
        indiceCorrente++; 
        await CaricaReso(listaIdResi[indiceCorrente]); 
    } 
}

private async Task Next() 
{ 
    if (listaIdResi != null && indiceCorrente > 0) 
    { 
        indiceCorrente--; 
        await CaricaReso(listaIdResi[indiceCorrente]); 
    } 
}



    private async Task StampaDocumentoReso()
{
    try
    {
        // 1. Recuperiamo i testi descrittivi per la testata
        var clienteSelezionato = listaClienti.FirstOrDefault(c => c.IdCliente == reso.IDCliente);
        var ordineSelezionato = listaOrdiniCliente.FirstOrDefault(o => o.IDOrdine == reso.IDOrdine);

        // 2. Popoliamo il modello per la stampa
        if (clienteSelezionato != null)
{
    reso.RagSociale = clienteSelezionato.RagSociale;
    reso.Indirizzo = clienteSelezionato.Ind_legale ?? "Indirizzo mancante in DB";
    reso.CAP = clienteSelezionato.CAP_Legale ?? "";
    reso.Citta = clienteSelezionato.Citta_Legale ?? "";
    reso.Provincia = clienteSelezionato.Prov_Legale ?? "";
    reso.PIva = clienteSelezionato.PIva ?? "";
}
        else
        {
            reso.RagSociale = "________________";
        }

        reso.Agente = "Gucci"; 
        
        if (ordineSelezionato != null)
        {
            reso.RifDocumentoVendita = ordineSelezionato.NumeroDocumento;
            reso.DataDocumentoVendita = ordineSelezionato.DataOrdine;
        }

        // --- POPOLAMENTO RIGHE (Mapping finale) ---
        reso.Righe = righeReso.Select(x => new DettaglioReso {
            Codice = x.Codice,
            // Qui formattiamo la descrizione come volevi: [CODICE] Descrizione
            Descrizione = $"[{x.Codice}] {x.Descrizione}", 
            Quantita = x.Quantita,
    
            // TRASFERIAMO I NUOVI CAMPI (fondamentali per il report)
            IsAccessorio = x.IsAccessorio,
            FinituraAccessorio = x.FinituraAccessorio,
            ColoreInt = x.ColoreInt,
            ColoreEst = x.ColoreEst,
    
            StatoBene = x.StatoBene,
            UmRiga = x.UmRiga
        }).ToList();




      

// 3. Generazione e Download (Corretto per Blazor Stream)
        var documento = new ResoDocument(reso);
        byte[] pdfBytes = documento.GeneratePdf();

        var fileName = $"Reso_{reso.RagSociale.Replace(" ", "_")}.pdf";
        
        using var stream = new MemoryStream(pdfBytes);
        using var streamRef = new DotNetStreamReference(stream);
        
        // Questo ora funzionerà senza l'errore arrayBuffer
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
    catch (Exception ex)
    {
        await Notifica("❌ Errore durante la generazione del PDF: " + ex.Message);
    }
}

private List<DettaglioOrdine> righeOrdineDisponibili = new();
private IList<DettaglioOrdine> selezionate = new List<DettaglioOrdine>(); 

private async Task CaricaRigheOrdinePerSelettore()
{
    if (reso.IDOrdine == null || reso.IDOrdine == 0) return;

    using var db = new SqlConnection(conn);
    // Recuperiamo le righe dell'ordine specifico
    var sql = @"SELECT * FROM Dettaglio_Ordini WHERE IDOrdine = @id";
    
    var result = await db.QueryAsync<DettaglioOrdine>(sql, new { id = reso.IDOrdine });
    righeOrdineDisponibili = result.ToList();
}

private List<DettaglioOrdine> righeOrdinePopup = new();


bool showModale = false;

string riferimentoOrdine = ""; // Variabile di supporto

async Task ApriModale()
{
    if (reso.IDOrdine == null || reso.IDOrdine == 0) return;

    using var db = new SqlConnection(conn);
    
    // Cerchiamo l'ordine nella lista esistente per prendere il NumeroDocumento
    var ordineSelezionato = listaOrdiniCliente.FirstOrDefault(o => o.IDOrdine == reso.IDOrdine);
    riferimentoOrdine = ordineSelezionato?.NumeroDocumento ?? reso.IDOrdine.ToString();

    var res = await db.QueryAsync<DettaglioOrdine>(
        "SELECT * FROM Dettaglio_Ordini WHERE IDOrdine = @id", 
        new { id = reso.IDOrdine }
    );
    righeOrdinePopup = res.ToList();
