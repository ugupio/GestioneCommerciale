@using GestioneCommerciale.Models
@using Microsoft.AspNetCore.Components.Web
@inject ProdottiService ProdottiService
@namespace GestioneCommerciale.Components

<div class="autocomplete-dropdown" style="position:relative; width:100%;">
	<input id="autocomplete-@((IsAccessorio) ? "acc" : "prof")" aria-label="@Placeholder" value="@SearchTextBacking" @oninput="OnInput" @onkeydown="OnKeyDown" placeholder="@Placeholder" class="form-control" style="display:block; width:100%; min-width:80px; height:32px; padding:6px; background:@(IsAccessorio ? "#f0fff0" : "#fffde7"); box-sizing: border-box;" />
	@if (ShowDropdown && Results?.Any() == true)
	{
		<div class="dropdown-panel" style="position:absolute; left:0; right:0; z-index:9999; background:white; border:1px solid #ddd; width:100%; max-height:240px; overflow:auto; box-shadow:0 6px 18px rgba(0,0,0,0.08);">
			<table style="width:100%; border-collapse:collapse; font-size:13px;">
				<thead style="position:sticky; top:0; background:#f8f9fa; font-weight:700;">
					<tr>
						<th style="padding:6px 8px; width:120px; text-align:left;">Codice</th>
						<th style="padding:6px 8px; text-align:left;">Descrizione</th>
					</tr>
				</thead>
				<tbody>
					@for (int i = 0; i < Results.Count; i++)
					{
						var r = Results[i];
						var cls = i == SelectedIndex ? "background:#e6f7ff;" : "";
						<tr style="cursor:pointer; @cls" @onclick="() => SelectItem(r)">
							<td style="padding:6px 8px; border-top:1px solid #f0f0f0;">@r.CodiceProdotto</td>
							<td style="padding:6px 8px; border-top:1px solid #f0f0f0;">@r.Descrizione</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
</div>

@code {
	[Parameter] public bool IsAccessorio { get; set; } = false; // false = profili, true = accessori
	[Parameter] public EventCallback<Prodotti> OnSelected { get; set; }
	[Parameter] public string Placeholder { get; set; } = "Cerca...";
	[Parameter] public int MaxResults { get; set; } = 20;

	private string SearchText { get; set; } = string.Empty;
	private List<Prodotti> Results { get; set; } = new();
	private bool ShowDropdown { get; set; } = false;
	private System.Timers.Timer debounceTimer;
	private int SelectedIndex = -1;

	protected override void OnInitialized()
	{
		debounceTimer = new System.Timers.Timer(300);
		debounceTimer.AutoReset = false;
		debounceTimer.Elapsed += async (s, e) => await InvokeAsync(async () => await DoSearch());
	}

	private void OnKeyDown(KeyboardEventArgs e)
	{
		if (!ShowDropdown) return;
		if (e.Key == "ArrowDown")
		{
			SelectedIndex = Math.Min(Results.Count - 1, SelectedIndex + 1);
		}
		else if (e.Key == "ArrowUp")
		{
			SelectedIndex = Math.Max(0, SelectedIndex - 1);
		}
		else if (e.Key == "Enter")
		{
			if (SelectedIndex >= 0 && SelectedIndex < Results.Count)
			{
				SelectItem(Results[SelectedIndex]);
			}
		}
		else if (e.Key == "Escape")
		{
			ShowDropdown = false;
		}
	}

	private void StartDebounce()
	{
		SelectedIndex = -1;
		debounceTimer.Stop();
		debounceTimer.Start();
	}

	private void SelectItem(Prodotti p)
	{
		SearchText = p.CodiceProdotto + " - " + p.Descrizione;
		ShowDropdown = false;
		Results.Clear();
		SelectedIndex = -1;
		OnSelected.InvokeAsync(p);
	}

	private async Task DoSearch()
	{
		try
		{
			if (string.IsNullOrWhiteSpace(SearchText))
			{
				Results = new List<Prodotti>();
				ShowDropdown = false;
			}
			else
			{
				var term = SearchText.Trim();
				Results = await ProdottiService.SearchProdottiAsync(term, IsAccessorio, MaxResults);
				ShowDropdown = Results.Any();
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Autocomplete error: {ex.Message}");
			Results = new List<Prodotti>();
			ShowDropdown = false;
		}
		StateHasChanged();
	}

	private void DisposeTimer()
	{
		if (debounceTimer != null)
		{
			debounceTimer.Stop();
			debounceTimer.Dispose();
			debounceTimer = null;
		}
	}

	public void Dispose()
	{
		DisposeTimer();
	}


	private async Task OnInput(ChangeEventArgs e)
	{
		SearchTextBacking = e?.Value?.ToString() ?? string.Empty;
		StartDebounce();
		await Task.CompletedTask;
	}

	private string _searchTextBacking;
	private string SearchTextBacking

	{
		get => _searchTextBacking;
		set
		{
			_searchTextBacking = value;
			SearchText = value; // keep SearchText in sync for DoSearch
		}
	}
}
